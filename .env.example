# Sequence debug overlay.
#   true  -> small overlay in the corner of the hero: FRAME 17 / 30 · PROGRESS 56%
#   false -> overlay is never mounted (zero runtime cost)
NEXT_PUBLIC_SEQUENCE_DEBUG=false
